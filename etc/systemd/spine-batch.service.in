[Unit]
Description=Cacti Spine Poller (Batch Cycle)
Documentation=https://www.cacti.net/spine.php
Documentation=https://github.com/Cacti/spine
After=network-online.target mariadb.service mysql.service
Wants=network-online.target
Requires=network-online.target
ConditionPathExists=@SPINE_CONF_PATH@

[Service]
Type=oneshot
SyslogIdentifier=spine
ExecStartPre=@SPINE_BIN_PATH@ --check
ExecStart=@SPINE_BIN_PATH@
# Oneshot guard: a runaway cycle must not hold the timer slot forever.
# 270s sits below the spine.timer cadence assumptions in docs/systemd.md;
# raise only if operators report large polls legitimately exceeding it.
TimeoutStartSec=270

User=spine
Group=spine

AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=yes
MemoryDenyWriteExecute=yes
UMask=0027
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

# 0700 keeps /run/spine root:spine-readable only so other local users
# cannot enumerate the telemetry socket or scratch files.
RuntimeDirectory=spine
RuntimeDirectoryMode=0700
StateDirectory=spine
StateDirectoryMode=0750
LogsDirectory=cacti
LogsDirectoryMode=0750

# Route stdout/err to the journal so operators see the batch's log
# stream uniformly with spine.service; without this, oneshot output
# ends up in /dev/null on some distros.
StandardOutput=journal
StandardError=journal

LimitCORE=0
LimitNOFILE=65536
LimitNPROC=4096
LimitMEMLOCK=infinity
LimitAS=4G
